@IdentityHabits.Api_HostAddress = http://localhost:5069

### Register
POST {{IdentityHabits.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "tester@example.com",
  "password": "correct-horse-battery-staple",
  "displayName": "Tester"
}

### Login
# @name login
POST {{IdentityHabits.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "tester@example.com",
  "password": "correct-horse-battery-staple"
}

### Current user
GET {{IdentityHabits.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

### Get profile
GET {{IdentityHabits.Api_HostAddress}}/api/profile
Authorization: Bearer {{login.response.body.token}}

### Update profile (name, email, time zone, avatar)
PUT {{IdentityHabits.Api_HostAddress}}/api/profile
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "displayName": "Tester McTest",
  "email": "tester@example.com",
  "timeZone": "America/New_York",
  "avatarUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
}

### Change password
PUT {{IdentityHabits.Api_HostAddress}}/api/profile/password
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "currentPassword": "correct-horse-battery-staple",
  "newPassword": "new-correct-horse-battery-staple"
}

### List identities
GET {{IdentityHabits.Api_HostAddress}}/api/identities
Authorization: Bearer {{login.response.body.token}}

### Create an identity
# @name createIdentity
POST {{IdentityHabits.Api_HostAddress}}/api/identities
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "statement": "I am a runner"
}

### Create a habit under that identity
POST {{IdentityHabits.Api_HostAddress}}/api/identities/{{createIdentity.response.body.id}}/habits
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Run 20 minutes",
  "scheduledDays": [1, 3, 5]
}

### Create a bad habit to break (tracked every day; "type": "Break")
POST {{IdentityHabits.Api_HostAddress}}/api/identities/{{createIdentity.response.body.id}}/habits
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "No late-night snacking",
  "type": "Break"
}

### Log a slip on the bad habit (a clean day carries no log — just DELETE to mark it clean)
PUT {{IdentityHabits.Api_HostAddress}}/api/habits/{{createHabit.response.body.id}}/logs/2026-07-27
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "Slipped"
}

### Today's dashboard
GET {{IdentityHabits.Api_HostAddress}}/api/dashboard/today
Authorization: Bearer {{login.response.body.token}}

### My stats (streaks & growth per habit)
GET {{IdentityHabits.Api_HostAddress}}/api/stats
Authorization: Bearer {{login.response.body.token}}

###
